# Puerto del API
PORT=3001

# Supabase (Project Settings > API). Usa la clave anon / publishable.
# NUNCA pongas aqui la service_role key: el API no la necesita.
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Origenes permitidos por CORS, separados por coma (Vite corre en 5173)
CORS_ORIGINS=http://localhost:5173
